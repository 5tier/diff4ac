{
  "name": "diff4ac",
  "version": "0.1.0",
  "description": "A read-only, keyboard-driven diff viewer for reviewing changes made by coding agents.",
  "private": true,
  "type": "module",
  "bin": {
    "diff4ac": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun run scripts/build-web.ts",
    "start": "bun run build && bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "1.60.0",
    "typescript": "^5.9.3"
  }
}
